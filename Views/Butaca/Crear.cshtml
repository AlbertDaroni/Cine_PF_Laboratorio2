
@model Proyecto_Final.Models.Butaca

@{
    ViewData["Title"] = "Nueva Butaca";
}

<h1>Registrar nueva butaca</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Crear" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Numero"
                       class="form-label">
                    Número de butaca
                </label>

                <input asp-for="Numero"
                       class="form-control"
                       maxlength="3"
                       placeholder="Ejemplo: A1, A2, B1" />

                <span asp-validation-for="Numero"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SalaID"
                       class="form-label">
                    Sala
                </label>

                <select asp-for="SalaID"
                        asp-items="ViewBag.Salas"
                        class="form-select">
                    <option value="0">
                        Seleccioná una sala
                    </option>
                </select>

                <span asp-validation-for="SalaID"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Guardar
            </button>

            <a asp-action="Indice"
               class="btn btn-secondary">
                Volver
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
