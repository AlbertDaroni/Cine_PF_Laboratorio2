
@model Proyecto_Final.Models.Butaca

@{
    ViewData["Title"] = "Editar Butaca";
}

<h1>Editar butaca</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Editar"
              asp-route-id="@Model.ID"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Numero"
                       class="form-label">
                    Número de butaca
                </label>

                <input asp-for="Numero"
                       class="form-control"
                       maxlength="3" />

                <span asp-validation-for="Numero"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Sala asignada
                </label>

                <select asp-for="SalaID"
                        asp-items="ViewBag.Salas"
                        class="form-select"
                        disabled>
                </select>

                <div class="form-text">
                    La sala asignada no puede modificarse.
                </div>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Guardar cambios
            </button>

            <a asp-action="Indice"
               class="btn btn-secondary">
                Volver
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
