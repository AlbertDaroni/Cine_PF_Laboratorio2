@model IEnumerable<Proyecto_Final.Models.Pago>

@{ ViewData["Title"] = "Listado de Pagos"; }

<h1>Listado de Pagos</h1>

<p><a asp-action="Crear" class="btn btn-primary">Crear nuevo pago</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Concepto</th>
            <th>Fecha de Pago</th>
            <th>Fecha de Anulacion</th>
            <th>Importe</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pago in Model) {
            <tr>
                <td>@pago.Concepto</td>
                <td>@pago.Fecha_Pago.ToString("dd/MM/yyyy")</td>
                <td>@(pago.Fecha_Anulacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                <td>@pago.Importe.ToString("C")</td>
                <td>@pago.Estado</td>
                <td>
                    <a asp-action="Detalles" asp-route-id="@pago.ID" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Modificar" asp-route-id="@pago.ID" class="btn btn-warning btn-sm">Modificar</a>
                    <a asp-action="Eliminar" asp-route-id="@pago.ID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>