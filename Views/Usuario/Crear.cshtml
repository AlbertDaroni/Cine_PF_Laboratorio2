@model Proyecto_Final.Models.Usuario

@{ ViewData["Title"] = "Nuevo Usuario"; }

<h1>Nuevo Usuario</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control">
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apellido" class="form-label"></label>
                <input asp-for="Apellido" class="form-control">
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control">
                <span asp-validation-for="DNI" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" type="email">
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contraseña" class="form-label"></label>
                <input asp-for="Contraseña" class="form-control" type="password">
                <span asp-validation-for="Contraseña" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Foto_Perfil" class="form-label">Foto de perfil</label>
                <input asp-for="Foto_Perfil" class="form-control" type="file" accept="image/*">
                <span asp-validation-for="Foto_Perfil" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RolID" class="form-label">Rol</label>
                <select asp-for="RolID" class="form-select" asp-items="(SelectList)ViewBag.Roles">
                    <option value="">-- Seleccioná un rol --</option>
                </select>
                <span asp-validation-for="RolID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-select">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Indice" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const buscarRol = document.getElementById("buscarRol");
        const rolID = document.getElementById("RolID");
        const resultados = document.getElementById("resultadosRoles");
        const estado = document.getElementById("estadoRoles");

        const urlBusqueda = '@Url.Action("BuscarRoles", "Usuario")';

        let temporizador;
        let versionBusqueda = 0;

        buscarRol.addEventListener("input", () => {
            clearTimeout(temporizador);

            const versionActual = ++versionBusqueda;
            const termino = buscarRol.value.trim();

            rolID.value = "0";
            resultados.replaceChildren();
            estado.textContent = "";

            if (termino.length < 2) return;

            temporizador = setTimeout(async () => {
                estado.textContent = "Buscando roles...";

                try {
                    const respuesta = await fetch(urlBusqueda + "?termino=" + encodeURIComponent(termino), {
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    if (!respuesta.ok || respuesta.redirected) throw new Error("Error de búsqueda.");

                    const roles = await respuesta.json();

                    if (versionActual !== versionBusqueda) return;

                    resultados.replaceChildren();

                    estado.textContent = roles.length ? "Seleccioná un rol de la lista." : "No se encontraron roles.";

                    for (const rol of roles) {
                        const boton = document.createElement("button");

                        boton.type = "button";
                        boton.className = "list-group-item list-group-item-action";
                        boton.textContent = rol.nombre;

                        boton.addEventListener("click", () => {
                            clearTimeout(temporizador);
                            ++versionBusqueda;

                            rolID.value = rol.id;
                            buscarRol.value = rol.nombre;

                            resultados.replaceChildren();
                            estado.textContent = "Rol seleccionado: " + rol.nombre;
                        });

                        resultados.appendChild(boton);
                    }
                } catch {
                    if (versionActual !== versionBusqueda) return;

                    estado.textContent = "No se pudo buscar. Intentá nuevamente.";
                }
            }, 300);
        });
    </script>
}