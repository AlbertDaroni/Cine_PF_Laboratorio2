@model Proyecto_Final.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<h1>Editar Usuario</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Editar" asp-route-id="@Model.ID" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ID">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control">
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apellido" class="form-label"></label>
                <input asp-for="Apellido" class="form-control">
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control">
                <span asp-validation-for="DNI" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control">
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <label asp-for="Contraseña" class="form-label">
                Nueva contraseña
            </label>

            <input type="password" id="Contraseña" name="Contraseña" autocomplete="new-password" class="form-control">

            <small class="form-text text-muted">
                Dejá este campo vacío para conservar la contraseña actual.
            </small>

            <span asp-validation-for="Contraseña" class="text-danger"></span>

            <div class="mb-3">
                <label asp-for="Foto_Perfil" class="form-label"></label>
                <input asp-for="Foto_Perfil" class="form-control" type="file" accept="image/*">
                <span asp-validation-for="Foto_Perfil" class="text-danger"></span>
            </div>

            @if (User.IsInRole("Administrador"))
            {
                <div class="mb-3">
                    <label asp-for="RolID" class="form-label"></label>
                    <select asp-for="RolID" class="form-select" asp-items="(SelectList)ViewBag.Roles">
                        <option value="">-- Seleccioná un rol --</option>
                    </select>
                    <span asp-validation-for="RolID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            } else {
                <input type="hidden" asp-for="RolID">
                <input type="hidden" asp-for="Estado">
            }

            <button type="submit" class="btn btn-success">Guardar cambios</button>
            <button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}