@model Proyecto_Final.Models.Usuario

@{ ViewData["Title"] = "Modificar Usuario"; }

<h1>Modificar Usuario</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Modificar" asp-route-id="@Model.ID" method="post">
            <input type="hidden" asp-for="ID">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control">
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DNI" class="form-label"></label>
                <input asp-for="DNI" class="form-control">
                <span asp-validation-for="DNI" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control">
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contraseña" class="form-label"></label>
                <input asp-for="Contraseña" type="password" class="form-control">
                <span asp-validation-for="Contraseña" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Foto_Perfil" class="form-label"></label>
                <input asp-for="Foto_Perfil" class="form-control" type="file">
                <span asp-validation-for="Foto_Perfil" class="text-danger"></span>
            </div>

            @if (User.IsInRole("Administrador")) {
                <div class="mb-3">
                    <label asp-for="Rol" class="form-label"></label>
                    <select asp-for="Rol" class="form-select">
                        <option value="Administrador">Administrador</option>
                        <option value="Propietario">Propietario</option>
                        <option value="Usuario">Usuario</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label"></label>
                    <select asp-for="Estado" class="form-select">
                        <option value="1">Activo</option>
                        <option value="0">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            }

            <button type="submit" class="btn btn-success">Guardar cambios</button>
            <button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}