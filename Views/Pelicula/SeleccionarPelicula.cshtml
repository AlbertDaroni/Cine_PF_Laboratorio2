@model IEnumerable<Proyecto_Final.Models.Pelicula>

@{ ViewData["Title"] = "Seleccionar Película"; }

<h1>Seleccionar Película para incluir en la Cartelera</h1>
<p class="text-muted">Hacé clic en "Seleccionar" para programar los horarios de la película en este cine.</p>

<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var pelicula in Model) {
        <div class="col">
            <div class="card h-100 text-center shadow-sm">
                <img src="~/uploads/portada/@pelicula.Portada" class="card-img-top" style="height: 200px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@pelicula.Titulo</h5>
                    <p class="card-text small text-muted">@pelicula.Duracion min | @pelicula.Clasificacion</p>
                    
                    <a asp-controller="Funcion" 
                       asp-action="CrearDesdeCartelera" 
                       asp-route-PeliculaID="@pelicula.ID" 
                       asp-route-CineID="@ViewBag.CineID" 
                       class="btn btn-success mt-auto">
                        Seleccionar
                    </a>
                </div>
            </div>
        </div>
    }
</div>
<div class="mt-4">
    <button type="button" onclick="history.back()" class="btn btn-secondary">Cancelar</button>
</div>