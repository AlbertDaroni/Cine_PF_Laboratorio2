@model IEnumerable<Proyecto_Final.Models.Pelicula>

@{ ViewData["Title"] = "Películas"; }

<h1>Películas</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Cartelera de Películas</h1>
    @if (User.IsInRole("Administrador") || User.IsInRole("Empleado")) {
        <a asp-action="Crear" class="btn btn-primary">Agregar</a>
    }
</div>

@* row-cols-1: 1 col en celular | row-cols-md-3: 3 cols en tablet | row-cols-xl-6: 6 cols en pantallas grandes *@
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-4">
    @foreach (var pelicula in Model) {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 position-relative">
                @* Badge de clasificación en la esquina de la portada *@
                <span class="position-absolute top-0 end-0 badge bg-dark m-2 bg-opacity-75">@pelicula.Clasificacion</span>
                @* Imagen de Portada (si no tiene, usa una por defecto) *@
                <img src="@(string.IsNullOrEmpty(pelicula.Idioma) ? "/img/no-poster.jpg" : "/img/posters/placeholder.jpg")" 
                    class="card-img-top rounded-top" 
                    alt="Portada de @pelicula.Titulo"
                    style="height: 260px; object-fit: cover;"
                >

                <div class="card-body d-flex flex-column p-3">
                    <h5 class="card-title text-truncate mb-1" title="@pelicula.Titulo">@pelicula.Titulo</h5>
                    @* Directores *@
                    <p class="card-text small text-muted text-truncate mb-2">
                        Dir: @(pelicula.Directores.Any() ? string.Join(", ", pelicula.Directores.Select(d => d.Nombre)) : "Desconocido")
                    </p>

                    @* Géneros (Lista horizontal limitada para que no rompa el diseño) *@
                    <div class="mb-3 text-truncate">
                        @foreach (var genero in pelicula.Generos.Take(2)) {
                            <span class="badge bg-secondary bg-opacity-25 text-dark sm-badge">@genero.Nombre</span>
                        }
                    </div>

                    @* Botones de acción al fondo de la tarjeta *@
                    <div class="mt-auto pt-2 border-top d-flex justify-content-between gap-1">
                        @if (User.IsInRole("Administrador") || User.IsInRole("Empleado")) {
                            <a asp-action="Editar" asp-route-id="@pelicula.ID" class="btn btn-outline-warning btn-sm flex-fill">Editar</a>
                            <a asp-action="Eliminar" asp-route-id="@pelicula.ID" class="btn btn-outline-danger btn-sm px-2">Eliminar</a>
                        } else {
                            <a asp-controller="Funcion" asp-action="VerFunciones" asp-route-peliculaId="@pelicula.ID" class="btn btn-success btn-sm w-100">Ver Funciones</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* Estilos rápidos en línea por si necesitas ajustar detalles del tamaño de los badges *@
<style>
    .sm-badge {
        font-size: 0.75rem;
        padding: 0.3em 0.5em;
    }
</style>