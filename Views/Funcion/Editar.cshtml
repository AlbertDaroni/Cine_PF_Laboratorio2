@model Proyecto_Final.Models.Funcion

@{ ViewData["Title"] = "Editar Función"; }

<h1>Editar</h1>

<form asp-action="Editar" method="post">
    <input type="hidden" asp-for="PeliculaID" value=ViewBag.PeliculaID>
    <input type="hidden" asp-for="SalaID" value=ViewBag.SalaID>

    <div class="mb-3">
        <label asp-for="FechaHora" class="form-label">Fecha y Hora</label>
        <input asp-for="FechaHora" class="form-control" type="datetime-local" />
        <span asp-validation-for="FechaHora" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Precio" class="form-label">Precio</label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PeliculaID" class="form-label">Película</label>
        <select asp-for="PeliculaID" class="form-select" asp-items="(SelectList)ViewBag.Peliculas">
            <option value="">-- Seleccioná una película --</option>
        </select>
        <span asp-validation-for="PeliculaID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SalaID" class="form-label">Sala</label>
        <select asp-for="SalaID" class="form-select" asp-items="(SelectList)ViewBag.Salas">
            <option value="">-- Seleccioná una sala --</option>
        </select>
        <span asp-validation-for="SalaID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select">
            <option value="true">Activa</option>
            <option value="false">Inactiva</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <button type="button" onclick="history.back()" class="btn btn-secondary">Volver</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial"/> }