@model IEnumerable<Proyecto_Final.Models.Funcion>

@{
    ViewData["Title"] = "Funciones";

    bool puedeGestionar = User.IsInRole("Administrador")
        || User.IsInRole("Empleado");
}

<h1>Funciones</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Esta película todavía no tiene funciones cargadas.
    </div>
}

@if (puedeGestionar)
{
    <a asp-action="Crear" class="btn btn-primary">Agregar</a>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha y Hora</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Película</th>
            <th>Sala</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var funcion in Model)
        {
            <tr>
                <td>@funcion.FechaHora</td>
                <td>@funcion.Precio</td>
                <td>
                    @if (funcion.Estado)
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactiva</span>
                    }
                </td>
                <td>@(funcion.Pelicula?.Titulo ?? "Sin película")</td>
                <td>@(funcion.Sala?.Numero.ToString() ?? "Sin sala")</td>
                <td>
                    @if (funcion.Estado && funcion.FechaHora > DateTime.Now)
                    {
                        @if (puedeGestionar)
                        {
                            <a asp-action="Editar"
                               asp-route-id="@funcion.ID"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>
                        }

                        <a asp-controller="Reserva"
                           asp-action="Crear"
                           asp-route-FuncionID="@funcion.ID"
                           class="btn btn-success btn-sm">
                            Reservar
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No disponible</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>