@model IEnumerable<Proyecto_Final.Models.Cine>

@{ ViewData["Title"] = "Listado de Cines"; }

<h1>Listado de Cines</h1>

<p><a asp-action="Crear" class="btn btn-primary">Agregar</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Direccion</th>
            <th>Abierto</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cine in Model) {
            <tr>
                <td>@cine.Nombre</td>
                <td>@cine.Direccion</td>
                <td>@(cine.Abierto ? "Sí" : "No")</td>
                <td>
                    <a asp-action="Detalles" asp-route-id="@cine.ID" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Editar" asp-route-id="@cine.ID" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Eliminar" asp-route-id="@cine.ID" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>