@model Proyecto_Final.Models.CrearReservaViewModel

@{
    ViewData["Title"] = "Editar reserva";
}

<h1>Editar reserva</h1>

<div class="alert alert-info">
    Las reservas no se modifican desde esta pantalla.
    Para cambiar la función o las butacas, utilizá el flujo
    de cancelación y creá una nueva reserva.
    La cancelación está sujeta a las restricciones de la reserva.
</div>

<a asp-action="Indice" class="btn btn-secondary">
    Volver a reservas
</a>