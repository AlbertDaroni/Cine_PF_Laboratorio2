@model IEnumerable<Proyecto_Final.Models.Reserva>

@{
    ViewData["Title"] = "Mis reservas";
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
}

<h1>Mis reservas</h1>

@if (TempData["Mensaje"] is string mensaje) {
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error) {
    <div class="alert alert-danger">@error</div>
}
@if (!Model.Any()) {
    <div class="alert alert-info">Todavía no tenés reservas.</div>
} else {
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>N.º</th>
                    <th>Película</th>
                    <th>Función</th>
                    <th>Butacas</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reserva in Model) {
                    <tr>
                        <td>@reserva.ID</td>
                        <td>@(reserva.Funcion?.Pelicula?.Titulo ?? "Sin título")</td>
                        <td>@(reserva.Funcion?.FechaHora.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</td>
                        <td>@string.Join(", ", reserva.Detalles.OrderBy(d => d.Butaca?.Numero).Select(d => d.Butaca?.Numero ?? "?"))</td>
                        <td>$&nbsp;@reserva.Monto.ToString("N2")</td>
                        <td>
                            @if (reserva.Estado) {
                                <span class="badge bg-success">Activa</span>
                            } else {
                                <span class="badge bg-danger">Cancelada</span>
                            }
                        </td>
                        <td><a asp-action="Detalles" asp-route-id="@reserva.ID" class="btn btn-info btn-sm">Detalles</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Páginas de reservas">
        @if (pagina > 1) {
            <a asp-action="Indice" asp-route-pagina="@(pagina - 1)" class="btn btn-outline-primary">Anterior</a>
        }

        <span class="mx-2">Página @pagina de @totalPaginas</span>

        @if (pagina < totalPaginas) {
            <a asp-action="Indice" asp-route-pagina="@(pagina + 1)" class="btn btn-outline-primary">Siguiente</a>
        }
    </nav>
}