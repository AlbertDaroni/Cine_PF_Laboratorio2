@model Proyecto_Final.Models.CrearReservaViewModel

@{ ViewData["Title"] = "Nueva reserva"; }

<h1>Reservar entradas</h1>

@if (TempData["Mensaje"] is string mensaje) {
    <div class="alert alert-success">@mensaje</div>
}

<h2>@Model.TituloPelicula</h2>

<p>Función: @Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</p>
<p>Precio por entrada: $@Model.PrecioEntrada.ToString("N2")</p>

<form asp-action="Crear" method="post">
    <input type="hidden" asp-for="FuncionID" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <fieldset class="mb-3">
        <legend>Seleccioná tus butacas</legend>
        @foreach (var butaca in Model.Butacas) {
            <div class="form-check">
                @if (butaca.Disponible) {
                    <input class="form-check-input" type="checkbox" name="ButacasSeleccionadas" value="@butaca.ID" id="butaca_@butaca.ID" />
                } else {
                    <input class="form-check-input" type="checkbox" id="butaca_@butaca.ID" disabled />
                }

                <label class="form-check-label" for="butaca_@butaca.ID">
                    @butaca.Numero
                    @(butaca.Disponible ? "Disponible" : "Reservada")
                </label>
            </div>
        }
    </fieldset>

    <button type="submit" class="btn btn-success">Confirmar reserva</button>
</form>